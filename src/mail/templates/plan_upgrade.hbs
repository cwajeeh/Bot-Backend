<div style='min-height: 100vh; background: #F6F9FB;'>
  <div
    style='display:-webkit-flex;display:-ms-flexbox;display:flex; margin-left:auto; margin-right:auto;  padding: 1.25rem; justify-content: center; width: 100%; max-width: 600px;'
  >
    <div
      style='overflow: hidden; border-width: 1px; border-radius: 10px; width: 100%; background-color: #ffffff;'
    >
      <div
        style='display:-webkit-flex;display:-ms-flexbox;display:flex; padding-top: 1.25rem; justify-content: center; align-items: center; margin-bottom: 1.25rem;'
      >
        <table width='100%' border='0' cellspacing='0' cellpadding='0'>
          <tr>
            <td align='center'>
              <img
                src='https://ac-webapp.s3.ap-southeast-1.amazonaws.com/assets/logo-B8zGj3zh.png'
                width='100'
                border='0'
              />
            </td>
          </tr>
        </table>
      </div>
      <div style='padding: 1.25rem; margin-bottom: 1.25rem;'>
        <p
          style='padding-bottom: 1.25rem; font-size: 0.875rem; line-height: 1.25rem;'
        >Hello {{username}},</p>
        <p
          style='padding-bottom: 1.25rem; font-size: 0.875rem; line-height: 1.25rem;'
        >
          Thank you for upgrading your AslasChat plan to <b>{{plan}}</b>! We're excited to continue providing you with the best experience.
        </p>
        <p
          style='padding-bottom: 1.25rem; font-size: 0.875rem; line-height: 1.25rem;'
        >
          Explore the new features of your <b>{{plan}}</b> plan and maximize your usage. If you have any questions or need assistance, feel free to reach us at <a href='mailto:support@aslaschat.ai' style='color: blue;'>support@aslaschat.ai</a>.
        </p>
        <p
          style='padding-bottom: 1.25rem; font-size: 0.875rem; line-height: 1.25rem;'
        >
          If you are unable to access your new plan, click this link:
          <a
            href='{{domain}}'
            style='color: blue;'
          >{{domain}}</a>
        </p>
        <p
          style='padding-bottom: 1.25rem; font-size: 0.875rem; line-height: 1.25rem;'
        >
          Thank you for choosing
          <a
            href='https://www.aslaschat.ai/'
            target='_blank'
            class='text-gray-600 hover:underline'
          ><b>AslasChat</b></a>!
        </p>
        <p
          style='padding-bottom: 1.25rem; font-size: 0.875rem; line-height: 1.25rem;'
        >
          Best regards,
        </p>
        <p
          style='padding-bottom: 1.25rem; font-size: 0.875rem; line-height: 1.25rem;'
        >
          AslasChat Team
        </p>
      </div>
      <div
        style='display:flex; flex-direction: column; align-items: center; padding: 1.25rem; font-size: 0.875rem; line-height: 1.25rem; color: #ffffff; background: linear-gradient(180deg, #56B76F 0%, #3D73B9 100%);'
      >
        <div
          style='font-size: 0.875rem; line-height: 1.25rem; margin-bottom: 1.25rem;'
        >
          <a href='https://www.aslaschat.ai/' target='_blank'>
            <img
              src='https://ac-webapp.s3.ap-southeast-1.amazonaws.com/assets/Logo.png'
              width='100'
              border='0'
            />
          </a>
        </div>
        <div
          style='font-size: 0.875rem; line-height: 1.25rem; margin-bottom: 1.25rem;'
        >
          Catch us on Social Media
        </div>
        <div
          style='font-size: 0.875rem; line-height: 1.25rem; margin-bottom: 1.25rem;'
        >
          <a href='https://www.facebook.com/aslaschat' target='_blank'>
            <img
              src='https://ac-webapp.s3.ap-southeast-1.amazonaws.com/assets/Facebook.svg'
              border='0'
              style='margin-right: 8px;'
            />
          </a>
          <a href='https://www.instagram.com/aslaschat/' target='_blank'>
            <img
              src='https://ac-webapp.s3.ap-southeast-1.amazonaws.com/assets/instagram.png'
              border='0'
              style='margin-right: 8px;'
            />
          </a>
          <a href='https://x.com/aslaschat' target='_blank'>
            <img
              src='https://ac-webapp.s3.ap-southeast-1.amazonaws.com/assets/X.svg'
              border='0'
              style='margin-right: 8px;'
            />
          </a>
          <a
            href='https://www.linkedin.com/company/aslaschat/?viewAsMember=true'
            target='_blank'
          >
            <img
              src='https://ac-webapp.s3.ap-southeast-1.amazonaws.com/assets/linkedin-02.png'
              border='0'
              style='margin-right: 8px;'
            />
          </a>
          <a href='https://www.pinterest.com/aslaschat1/' target='_blank'>
            <img
              src='https://ac-webapp.s3.ap-southeast-1.amazonaws.com/assets/pintrest.svg'
              border='0'
            />
          </a>
        </div>
        <div
          style='font-size: 0.875rem; line-height: 1.25rem; margin-bottom: 1.25rem;'
        >
          Al Maryah Island, Abu Dhabi Emirate
        </div>
        <div
          style='font-size: 0.75rem; line-height: 1rem; margin-bottom: 1.25rem;'
        >
          ©2024 AslasChat. All rights reserved
        </div>
      </div>
    </div>
  </div>
</div>
